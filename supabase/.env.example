# Edge Function secrets. Copy this file to `supabase/.env`, fill in real values,
# then run:  npx supabase secrets set --env-file supabase/.env
#
# `supabase/.env` is git-ignored. NEVER commit real keys. These are NOT the same
# as the frontend `.env.local` (which only holds public VITE_ values).

# --- AI assistant (Sahayak) --- FREE option: Groq ---------------------------
# Sign up at https://console.groq.com  (free, no card) -> API Keys -> Create.
LLM_API_KEY=gsk_REPLACE_ME
# Check your account's available models:  curl https://api.groq.com/openai/v1/models
#   -H "Authorization: Bearer $LLM_API_KEY"
# Good current choices: qwen/qwen3.8-27b  or  openai/gpt-oss-20b
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=qwen/qwen3.8-27b

# (Alternative, paid) Claude instead of Groq — leave LLM_API_KEY blank and set:
# ANTHROPIC_API_KEY=sk-ant-api03-...
# ASSISTANT_MODEL=claude-haiku-4-5

# --- Payment gateway (Razorpay TEST mode — FREE, no KYC) -------------------
# https://dashboard.razorpay.com/signup -> switch to Test Mode ->
#   Settings -> API Keys -> Generate Test Key
RAZORPAY_KEY_ID=rzp_test_REPLACE_ME
RAZORPAY_KEY_SECRET=REPLACE_ME
# Any long random string you choose; paste the SAME value into the Razorpay
# dashboard when you create the webhook.
RAZORPAY_WEBHOOK_SECRET=REPLACE_ME_with_a_long_random_string
