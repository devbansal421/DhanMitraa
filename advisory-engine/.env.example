# Copy to .env for local runs (Makefile / uvicorn read it via your shell).
# EVERYTHING here is optional — with no key the engine still returns the full
# deterministic advisory and marks the narrative "unconfigured".

# --- AI narrative — FREE path: Groq (console.groq.com, no card) ---------------
LLM_API_KEY=gsk_REPLACE_ME
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.3-70b-versatile
LLM_FALLBACK_MODEL=openai/gpt-oss-20b
LLM_TIMEOUT_SECONDS=30

# --- HTTP -------------------------------------------------------------------
# Comma-separated. Use your Vercel URL(s) in production instead of "*".
CORS_ALLOW_ORIGINS=*
# Optional shared secret. When set, callers must send  X-API-Key: <value>
# ADVISORY_API_KEY=
