# Public browser configuration only. Do not add SUPABASE_SERVICE_ROLE_KEY,
# ANTHROPIC_API_KEY, or RAZORPAY_KEY_SECRET here — those are Edge Function
# secrets set with `supabase secrets set`, never VITE_ variables.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
# Public URL used in email confirmation links. Must be allowed in Supabase Auth.
VITE_AUTH_REDIRECT_URL=https://app.your-domain.example

# Optional: turn on the real payment gateway for "Add money" (Razorpay).
# Leave unset to use the built-in simulation.
# VITE_PAYMENTS_PROVIDER=razorpay

# Optional: use the server-backed wallet (needs migration 202609080008 applied
# and the wallet-transfer function deployed). Defaults to the local simulation.
# VITE_WALLET_BACKEND=supabase
